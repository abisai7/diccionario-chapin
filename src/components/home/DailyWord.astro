---
import type { CollectionEntry } from "astro:content";
import { getCategoryColor } from "../../utils/categoryColors";
import { useTranslations } from "../../utils/i18n";
import { CalendarHeart } from "@lucide/astro";

interface Props {
  words: CollectionEntry<"words-es" | "words-en">[];
  lang: string;
  standalone?: boolean;
}

const { words, lang, standalone = true } = Astro.props;
const t = useTranslations(lang);

if (words.length === 0) {
  return;
}

const today = new Date();
const dateFormatter = new Intl.DateTimeFormat(lang === "es" ? "es-GT" : "en-US", {
  weekday: "long",
  year: "numeric",
  month: "long",
  day: "numeric",
});
const formattedDate = dateFormatter.format(today);
const todayISO = today.toISOString().slice(0, 10);

// ─── Compute the daily word server-side ──────────────────────────────────────
// This avoids sending the full word list to the browser. The same hash function
// is used in the client script; both must stay in sync.
function hashCode(str: string): number {
  let hash = 0;
  for (let i = 0; i < str.length; i++) {
    const char = str.charCodeAt(i);
    hash = (hash << 5) - hash + char;
    hash |= 0;
  }
  return Math.abs(hash);
}

const dailyIndex = hashCode(todayISO) % words.length;
const dailyEntry = words[dailyIndex];
const dailyWord = {
  id: dailyEntry.id,
  word: dailyEntry.data.word,
  meaning: dailyEntry.data.meaning,
  examples: dailyEntry.data.examples ?? [],
  synonyms: dailyEntry.data.synonyms?.filter(Boolean) ?? [],
  category: dailyEntry.data.category,
  color: getCategoryColor(dailyEntry.data.category),
};

// Only the single computed daily word is passed to the client. If the
// client-side date differs (e.g. user crosses midnight), we keep the build-time
// word to avoid a flash — the page will refresh on next navigation.
const jsonData = JSON.stringify(dailyWord);
const learnMoreLabel = t("home.dailyWord.learnMore");
const synonymsLabel = t("home.dailyWord.synonyms");

// SSR fallback renders the already-computed daily word (no client-side swap needed
// unless the word for today differs from words[0], which it won't now)
const fallback = dailyEntry;
const fallbackColor = dailyWord.color;

function cardBody(word: typeof fallback.data, color: string, wordId: string) {
  const examples = (word.examples ?? []).slice(0, 2);
  const synonyms = (word.synonyms ?? []).filter(Boolean);
  return `
    <div>
      <div class="mb-3 flex flex-wrap items-center gap-3">
        <h3 class="text-text my-0 text-2xl font-semibold transition-colors duration-200 ease-out group-hover:text-[var(--primary)]">
          ${word.word}
        </h3>
        <span class="inline-block rounded-full px-2.5 py-0.5 text-xs font-medium text-white" style="background-color: ${color};">
          ${word.category}
        </span>
      </div>
      <p class="text-secondary my-0 mb-3 text-base leading-relaxed">${word.meaning}</p>
      ${
        examples.length > 0
          ? examples
              .map(
                (ex) =>
                  `<div class="accent-box mb-3 rounded-r-lg px-4 py-2 text-sm">&ldquo;${ex}&rdquo;</div>`
              )
              .join("")
          : ""
      }
      ${
        synonyms.length > 0
          ? `
      <div class="mb-3">
        <span class="text-muted text-xs font-medium">${synonymsLabel}:</span>
        <div class="mt-1.5 flex flex-wrap gap-1.5">
          ${synonyms.map((s) => `<span class="border-theme text-muted inline-block rounded-full border px-2 py-0.5 text-xs">${s}</span>`).join("")}
        </div>
      </div>`
          : ""
      }
    </div>
    <div class="mt-auto">
      <div class="bg-glow-primary mb-3 h-px"></div>
      <span class="text-sm font-medium text-[var(--link-primary)] group-hover:underline">
        ${learnMoreLabel} &rarr;
      </span>
    </div>`;
}

const cardClasses =
  "group border-theme bg-card hover:bg-card-hover flex flex-1 flex-col rounded-xl border p-5 transition duration-200 ease-out hover:-translate-y-1 hover:border-[var(--primary)]";
---

{
  standalone ? (
    <section id="daily-word" class="mx-auto mb-6 max-w-275 px-6">
      <div class="card-with-gradient relative flex flex-col overflow-hidden p-6">
        <div class="relative z-10 shrink-0">
          <h2 class="my-0 flex items-center gap-2 text-2xl text-balance">
            <CalendarHeart />
            {t("home.dailyWord.title")}
          </h2>
          <p class="text-muted text-sm" id="daily-date">
            {formattedDate}
          </p>
        </div>

        {/* min-height prevents CLS when the SSR content already matches the daily word */}
        <div class="relative z-10 mt-5 flex min-h-48 flex-1 flex-col" id="daily-word-content">
          <a
            href={`/${lang}/palabras/${fallback.id}/`}
            class={cardClasses}
            data-umami-event="Daily Word Click"
            data-umami-event-word={fallback.data.word}
          >
            <Fragment set:html={cardBody(fallback.data, fallbackColor, fallback.id)} />
          </a>
        </div>
      </div>
    </section>
  ) : (
    <div
      id="daily-word"
      class="card-with-gradient relative flex h-full flex-col overflow-hidden p-6"
    >
      <div class="relative z-10 shrink-0">
        <h2 class="my-0 flex items-center gap-2 text-2xl text-balance">
          <CalendarHeart />
          {t("home.dailyWord.title")}
        </h2>
        <p class="text-muted text-sm" id="daily-date">
          {formattedDate}
        </p>
      </div>

      {/* min-height prevents CLS when the SSR content already matches the daily word */}
      <div class="relative z-10 mt-5 flex min-h-48 flex-1 flex-col" id="daily-word-content">
        <a
          href={`/${lang}/palabras/${fallback.id}/`}
          class={cardClasses}
          data-umami-event="Daily Word Click"
          data-umami-event-word={fallback.data.word}
        >
          <Fragment set:html={cardBody(fallback.data, fallbackColor, fallback.id)} />
        </a>
      </div>
    </div>
  )
}

<script define:vars={{ dailyWordJSON: jsonData, learnMoreLabel, synonymsLabel, todayISO }}>
  (function () {
    // The server already computed the correct daily word for today; the SSR
    // fallback content IS the daily word. No DOM replacement is needed unless
    // the client's local date happens to differ (e.g. user crossed midnight).
    // In that rare case we leave the server-rendered word in place — it will
    // refresh on the next navigation. This eliminates the innerHTML swap that
    // was the main source of CLS on this component.

    // Keep the script lightweight: just verify the date matches.
    const word = JSON.parse(dailyWordJSON);
    const today = new Date().toISOString().slice(0, 10);
    if (today === todayISO) {
      // Server and client agree — nothing to do.
      return;
    }

    // Rare: client date differs from build date. Update the date display only.
    const dateEl = document.getElementById("daily-date");
    if (dateEl) {
      const lang = document.documentElement.lang?.startsWith("en") ? "en-US" : "es-GT";
      dateEl.textContent = new Intl.DateTimeFormat(lang, {
        weekday: "long",
        year: "numeric",
        month: "long",
        day: "numeric",
      }).format(new Date());
    }
  })();
</script>
