---
// Lanza confetti azul y blanco una vez al entrar al sitio.
// Sin markup visible; solo inyecta un script de celebración.
---

<script>
  (function () {
    const key = "chapinismos-confetti-fired";

    if (sessionStorage.getItem(key)) {
      return;
    }

    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reduceMotion) {
      sessionStorage.setItem(key, "1");
      return;
    }

    const COLORS = ["#4997d0", "#60a5fa", "#5fa8dc", "#ffffff", "#e8f2ff"];

    function burst(x: number, y: number) {
      import("canvas-confetti").then((mod) =>
        mod.default({
          particleCount: 90,
          spread: 75,
          startVelocity: 45,
          origin: { x, y },
          colors: COLORS,
          scalar: 0.9,
          zIndex: 9999,
          disableForReducedMotion: true,
        })
      );
    }

    function paperRibbon() {
      import("canvas-confetti").then((mod) =>
        mod.default({
          particleCount: 30,
          spread: 100,
          angle: 90,
          startVelocity: 55,
          gravity: 0.7,
          ticks: 220,
          shapes: ["square"],
          scalar: 0.8,
          origin: { x: 0, y: 0.4 },
          colors: ["#4997d0", "#ffffff", "#60a5fa"],
          disableForReducedMotion: true,
        })
      );
    }

    function celebrate() {
      burst(0.5, 0.35);
      window.setTimeout(() => burst(0.25, 0.4), 250);
      window.setTimeout(() => burst(0.75, 0.4), 500);
      window.setTimeout(paperRibbon, 350);
      sessionStorage.setItem(key, "1");
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", celebrate, { once: true });
    } else {
      celebrate();
    }
  })();
</script>
