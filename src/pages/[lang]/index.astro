---
export const prerender = true;

import Base from "../../layouts/Base.astro";
import Ticker from "../../components/Ticker.astro";
import HeroSection from "../../components/home/HeroSection.astro";
import AboutSection from "../../components/home/AboutSection.astro";
import DailyWord from "../../components/home/DailyWord.astro";
import FeaturedWords from "../../components/home/FeaturedWords.astro";
import LatestWords from "../../components/home/LatestWords.astro";
import GuatemalaSlider from "../../components/home/GuatemalaSlider.astro";
import CelebrationSlider from "../../components/home/CelebrationSlider.astro";
import ContributeSection from "../../components/home/ContributeSection.astro";
import BreadcrumbSchema from "../../components/schemas/BreadcrumbSchema.astro";
import FeaturedWordsSchema from "../../components/schemas/FeaturedWordsSchema.astro";
import { getCollection, type CollectionEntry } from "astro:content";
import { useTranslations } from "../../utils/i18n";
import popularSlugs from "../../data/popular-slugs.json";
import { buildUnsplashUrl } from "../../utils/unsplash";

export async function getStaticPaths() {
  return [{ params: { lang: "es" } }, { params: { lang: "en" } }];
}

const { lang } = Astro.params;
const t = useTranslations(lang);

const collectionName = lang === "es" ? "words-es" : "words-en";
const allWords = await getCollection(collectionName);

// Hreflang URLs for multilingual SEO
const alternateUrls = {
  es: "/es/",
  en: "/en/",
  xDefault: "/es/", // Default to Spanish
};
const wordList = allWords.map((w) => w.data.word);
const shuffled = [...wordList].sort(() => Math.random() - 0.5);
const featured = shuffled.slice(0, Math.min(45, shuffled.length));

const FEATURED_WORDS_COUNT = 6;
const LATEST_WORDS_COUNT = 6;

const popularWords = popularSlugs
  .map((slug) => allWords.find((w) => w.id === slug))
  .filter((w): w is CollectionEntry<"words-es" | "words-en"> => w !== undefined);

const allWordIds = allWords.map((w) => w.id);

// Get featured words or fallback to random if none are marked
const featuredWords = allWords.filter((w) => w.data.featured === true);
const top =
  featuredWords.length >= FEATURED_WORDS_COUNT
    ? featuredWords.slice(0, FEATURED_WORDS_COUNT)
    : [...allWords].sort(() => Math.random() - 0.5).slice(0, FEATURED_WORDS_COUNT);

const latestWords = [...allWords]
  .sort(
    (a, b) => new Date(b.data.publishedDate).getTime() - new Date(a.data.publishedDate).getTime()
  )
  .slice(0, LATEST_WORDS_COUNT);

const siteUrl = Astro.site || "https://chapinismos.org";

// ─── Celebration Slider ─────────────────────────────────────────────────────
// Fetch slides here so we can (a) pass them to the component to avoid a
// duplicate build-time request and (b) emit a <link rel="preload"> for the
// first slide image directly in <head> for an earlier LCP signal.

const CELEBRATION_PHOTO_IDS: { id: string; alt: string }[] = [
  { id: "-hbgU510TzU", alt: "Bandera de Guatemala ondeando bajo un cielo nublado" },
  { id: "uliZMHrDgzM", alt: "Calle de la ciudad con una torre del reloj al fondo" },
  { id: "Lej_-3cke2c", alt: "Muelle cerca del agua con una montaña cónica al fondo" },
  { id: "xHtttDKOljE", alt: "Edificio antiguo con arcos" },
  { id: "gLtJea5taXo", alt: "Semuc Champey, lugar turístico en Guatemala" },
  { id: "g9Ai-jaGsWU", alt: "Mercado típico de Guatemala" },
  { id: "yJCrK6IIA24", alt: "Tienda de trajes típicos de Guatemala" },
];

type SliderSlide = { url: string; alt: string; photographer: string; photographerUrl: string };
let celebrationSlides: SliderSlide[] = [];

const unsplashKey = import.meta.env.UNSPLASH_ACCESS_KEY;
if (unsplashKey) {
  try {
    const results = await Promise.all(
      CELEBRATION_PHOTO_IDS.map(({ id }) =>
        fetch(`https://api.unsplash.com/photos/${id}?client_id=${unsplashKey}`).then((res) =>
          res.ok ? res.json() : null
        )
      )
    );
    celebrationSlides = results
      .filter((img): img is any => Boolean(img))
      .map((img, i) => ({
        url: img.urls?.raw || img.urls?.regular || img.urls?.small || "",
        alt: CELEBRATION_PHOTO_IDS[i]?.alt || img.alt_description || "Guatemala",
        photographer: img.user?.name || "Unknown",
        photographerUrl: img.user?.links?.html || "#",
      }))
      .filter((s) => s.url);
  } catch {
    // Graceful fallback: render nothing if API fails
  }
}

// URL for the <link rel="preload"> hero image (first slide, AVIF, 960px wide)
const heroPreloadUrl = celebrationSlides[0]?.url
  ? buildUnsplashUrl(celebrationSlides[0].url, 960, "avif", 60)
  : null;

// ─── Guatemala Photo Slider ───────────────────────────────────────────────────
let guatemalaImages: { url: string; alt: string; photographer: string; photographerUrl: string }[] =
  [];
if (unsplashKey) {
  try {
    const res = await fetch(
      `https://api.unsplash.com/search/photos?query=guatemala&per_page=10&orientation=landscape&client_id=${unsplashKey}`
    );
    if (res.ok) {
      const data = await res.json();
      guatemalaImages = (data.results || []).map((img: any) => ({
        // Store `urls.raw` so GuatemalaSlider can build WebP srcsets at any width.
        // Fall back to `regular` (already sized) if raw is unavailable.
        url: img.urls?.raw || img.urls?.regular || img.urls?.small || "",
        alt: img.alt_description || "Guatemala photo",
        photographer: img.user?.name || "Unknown",
        photographerUrl: img.user?.links?.html || "#",
      }));
    }
  } catch {
    // Graceful fallback: render nothing if API fails
  }
}
---

<Base
  title={t("home.title")}
  description={t("home.description")}
  keywords={t("home.keywords")}
  lang={lang}
  alternateUrls={alternateUrls}
>
  <BreadcrumbSchema slot="schema" lang={lang} siteUrl={siteUrl} items={[]} />
  <FeaturedWordsSchema slot="schema" lang={lang} siteUrl={siteUrl} words={top} />

  {/* Preload hero slider image so the browser fetches it as early as possible (LCP) */}
  {
    heroPreloadUrl && (
      <link slot="preload" rel="preload" as="image" href={heroPreloadUrl} fetchpriority="high" />
    )
  }

  <CelebrationSlider lang={lang} slides={celebrationSlides} />

  <HeroSection lang={lang} popularWords={popularWords} allWordIds={allWordIds} />

  <div class="mx-auto mb-6 grid max-w-275 grid-cols-1 gap-6 px-6 lg:grid-cols-[5fr_2fr]">
    <div
      class="card-with-gradient flex flex-col p-6 [&_section]:mx-0 [&_section]:max-w-none [&_section]:px-0 [&_section:last-child]:mb-0"
    >
      <FeaturedWords words={top} lang={lang} />
      <LatestWords words={latestWords} lang={lang} />
    </div>
    <DailyWord words={allWords} lang={lang} standalone={false} />
  </div>

  {guatemalaImages.length > 0 && <GuatemalaSlider images={guatemalaImages} />}

  <AboutSection lang={lang} />

  <section class="mx-auto max-w-275 px-6">
    <Ticker words={featured} lang={lang} variant="vibrant" rows={1} />
  </section>

  <ContributeSection lang={lang} />
</Base>
